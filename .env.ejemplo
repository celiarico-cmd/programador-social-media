# Claves secretas. /empezar crea el archivo .env a partir de este y te dice cuáles necesitas según tus elecciones.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore). Nunca pegues estas claves en el chat.
# Rellena solo las que uses; el resto déjalas vacías.

# --- Programador por API (si elegiste MCP, no hace falta ninguna) ---
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
HOOTSUITE_CLIENT_ID=
HOOTSUITE_CLIENT_SECRET=
ZERNIO_API_KEY=
BUFFER_API_KEY=
POSTIZ_API_KEY=

# --- Alojamiento de imágenes (solo si tu programador no las recibe directamente) ---
CLOUDINARY_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
IMAGEKIT_PRIVATE_KEY=

# --- Calendario (opcional; solo el de tu herramienta) ---
NOTION_TOKEN=
AIRTABLE_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Figma por API (opcional; solo si diseñas en Figma) ---
FIGMA_TOKEN=
